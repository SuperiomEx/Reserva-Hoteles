/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": []    // Angular CLI deja esto vacío para la app de navegador
  },
  "files": [
    "src/main.ts",       // punto de entrada de la aplicación en navegador
    "src/polyfills.ts"   // 
  ],
  "include": [
    "src/**/*.d.ts",     // declaraciones globales
    "src/**/*.ts",       // TODOS los .ts de la app
    "src/**/*.html"      // plantillas Angular (para que strictTemplates funcione)
  ],
  "exclude": [
    "src/test.ts",       // archivo de test puntal (se usa en tsconfig.spec.json)
    "src/**/*.spec.ts",  // tests unitarios
    "**/*.test.ts"
  ],

  "angularCompilerOptions": {
    "strictTemplates": true
  }

}
